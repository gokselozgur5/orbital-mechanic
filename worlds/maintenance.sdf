<?xml version="1.0"?>
<sdf version="1.9"><world name="maintenance">
<physics name="default" type="ignored"><max_step_size>.002</max_step_size><real_time_factor>1</real_time_factor></physics>
<plugin filename="gz-sim-physics-system" name="gz::sim::systems::Physics"/>
<plugin filename="gz-sim-user-commands-system" name="gz::sim::systems::UserCommands"/>
<plugin filename="gz-sim-scene-broadcaster-system" name="gz::sim::systems::SceneBroadcaster"/>
<plugin filename="gz-sim-sensors-system" name="gz::sim::systems::Sensors"><render_engine>ogre2</render_engine></plugin>
<plugin filename="gz-sim-imu-system" name="gz::sim::systems::Imu"/>
<scene><ambient>.6 .6 .6 1</ambient><background>.08 .1 .15 1</background><shadows>false</shadows></scene>
<light type="directional" name="sun"><pose>0 0 8 0 0 0</pose><diffuse>.8 .8 .8 1</diffuse><direction>-.5 .2 -1</direction><cast_shadows>false</cast_shadows></light>
<model name="floor"><static>true</static><pose>0 0 -0.1 0 0 0</pose><link name="body"><collision name="collision"><geometry><box><size>10 8 0.2</size></box></geometry></collision><visual name="visual"><geometry><box><size>10 8 0.2</size></box></geometry><material><ambient>0.25 0.28 0.32 1</ambient><diffuse>0.25 0.28 0.32 1</diffuse></material></visual></link></model><model name="north"><static>true</static><pose>0 4 1 0 0 0</pose><link name="body"><collision name="collision"><geometry><box><size>10 .15 2</size></box></geometry></collision><visual name="visual"><geometry><box><size>10 .15 2</size></box></geometry><material><ambient>0.65 .7 .75 1</ambient><diffuse>0.65 .7 .75 1</diffuse></material></visual></link></model><model name="south"><static>true</static><pose>0 -4 1 0 0 0</pose><link name="body"><collision name="collision"><geometry><box><size>10 .15 2</size></box></geometry></collision><visual name="visual"><geometry><box><size>10 .15 2</size></box></geometry><material><ambient>0.65 .7 .75 1</ambient><diffuse>0.65 .7 .75 1</diffuse></material></visual></link></model><model name="east"><static>true</static><pose>5 0 1 0 0 0</pose><link name="body"><collision name="collision"><geometry><box><size>.15 8 2</size></box></geometry></collision><visual name="visual"><geometry><box><size>.15 8 2</size></box></geometry><material><ambient>0.65 .7 .75 1</ambient><diffuse>0.65 .7 .75 1</diffuse></material></visual></link></model><model name="west"><static>true</static><pose>-5 0 1 0 0 0</pose><link name="body"><collision name="collision"><geometry><box><size>.15 8 2</size></box></geometry></collision><visual name="visual"><geometry><box><size>.15 8 2</size></box></geometry><material><ambient>0.65 .7 .75 1</ambient><diffuse>0.65 .7 .75 1</diffuse></material></visual></link></model><model name="pump"><static>true</static><pose>3 1.8 .6 0 0 0</pose><link name="body"><collision name="collision"><geometry><box><size>.8 .8 1.2</size></box></geometry></collision><visual name="visual"><geometry><box><size>.8 .8 1.2</size></box></geometry><material><ambient>.1 .5 .8 1</ambient><diffuse>.1 .5 .8 1</diffuse></material></visual></link></model><model name="cooler"><static>true</static><pose>3 0 .6 0 0 0</pose><link name="body"><collision name="collision"><geometry><box><size>.8 .8 1.2</size></box></geometry></collision><visual name="visual"><geometry><box><size>.8 .8 1.2</size></box></geometry><material><ambient>.1 .7 .4 1</ambient><diffuse>.1 .7 .4 1</diffuse></material></visual></link></model><model name="power_unit"><static>true</static><pose>3 -1.8 .6 0 0 0</pose><link name="body"><collision name="collision"><geometry><box><size>.8 .8 1.2</size></box></geometry></collision><visual name="visual"><geometry><box><size>.8 .8 1.2</size></box></geometry><material><ambient>.8 .5 .1 1</ambient><diffuse>.8 .5 .1 1</diffuse></material></visual></link></model>
<model name="maintenance_robot"><pose>0 0 .02 0 0 0</pose>
<link name="base_link"><pose>0 0 .22 0 0 0</pose><inertial><mass>8</mass><inertia><ixx>.15</ixx><iyy>.2</iyy><izz>.25</izz></inertia></inertial>
<collision name="collision"><geometry><box><size>.55 .4 .16</size></box></geometry></collision><visual name="visual"><geometry><box><size>.55 .4 .16</size></box></geometry><material><ambient>.8 .3 .15 1</ambient><diffuse>.8 .3 .15 1</diffuse></material></visual>
<sensor name="camera" type="camera"><pose>.28 0 .12 0 0 0</pose><topic>/camera/image_raw</topic><gz_frame_id>camera_optical_frame</gz_frame_id><update_rate>5</update_rate><camera><horizontal_fov>1.2</horizontal_fov><image><width>640</width><height>480</height><format>R8G8B8</format></image><clip><near>.05</near><far>30</far></clip><camera_info_topic>/camera/camera_info</camera_info_topic></camera></sensor>
<sensor name="lidar" type="gpu_lidar"><pose>0 0 .16 0 0 0</pose><topic>/scan</topic><gz_frame_id>lidar_link</gz_frame_id><update_rate>10</update_rate><lidar><scan><horizontal><samples>360</samples><resolution>1</resolution><min_angle>-3.14159</min_angle><max_angle>3.14159</max_angle></horizontal></scan><range><min>.1</min><max>12</max><resolution>.01</resolution></range></lidar></sensor>
<sensor name="imu" type="imu"><topic>/imu</topic><gz_frame_id>base_link</gz_frame_id><update_rate>20</update_rate></sensor>
</link>
<link name="caster"><pose>-.2 0 .06 0 0 0</pose><inertial><mass>.1</mass><inertia><ixx>.001</ixx><iyy>.001</iyy><izz>.001</izz></inertia></inertial><collision name="collision"><geometry><sphere><radius>.06</radius></sphere></geometry><surface><friction><ode><mu>0</mu><mu2>0</mu2></ode></friction></surface></collision><visual name="visual"><geometry><sphere><radius>.06</radius></sphere></geometry></visual></link>
<joint name="caster_joint" type="fixed"><parent>base_link</parent><child>caster</child></joint>
<link name="left_wheel"><pose>0 0.24 .12 1.570796 0 0</pose><inertial><mass>1</mass><inertia><ixx>.004</ixx><iyy>.004</iyy><izz>.007</izz></inertia></inertial><collision name="collision"><geometry><cylinder><radius>.12</radius><length>.06</length></cylinder></geometry></collision><visual name="visual"><geometry><cylinder><radius>.12</radius><length>.06</length></cylinder></geometry><material><ambient>.1 .1 .1 1</ambient></material></visual></link><joint name="left_wheel_joint" type="revolute"><parent>base_link</parent><child>left_wheel</child><axis><xyz expressed_in="__model__">0 1 0</xyz><limit><effort>8</effort><velocity>8</velocity></limit></axis></joint><link name="right_wheel"><pose>0 -0.24 .12 1.570796 0 0</pose><inertial><mass>1</mass><inertia><ixx>.004</ixx><iyy>.004</iyy><izz>.007</izz></inertia></inertial><collision name="collision"><geometry><cylinder><radius>.12</radius><length>.06</length></cylinder></geometry></collision><visual name="visual"><geometry><cylinder><radius>.12</radius><length>.06</length></cylinder></geometry><material><ambient>.1 .1 .1 1</ambient></material></visual></link><joint name="right_wheel_joint" type="revolute"><parent>base_link</parent><child>right_wheel</child><axis><xyz expressed_in="__model__">0 1 0</xyz><limit><effort>8</effort><velocity>8</velocity></limit></axis></joint>
<plugin filename="gz-sim-diff-drive-system" name="gz::sim::systems::DiffDrive"><left_joint>left_wheel_joint</left_joint><right_joint>right_wheel_joint</right_joint><wheel_separation>.48</wheel_separation><wheel_radius>.12</wheel_radius><topic>/demo/private/cmd_vel</topic><odom_topic>/odom</odom_topic><tf_topic>/tf</tf_topic><frame_id>odom</frame_id><child_frame_id>base_link</child_frame_id><odom_publish_frequency>20</odom_publish_frequency><max_linear_velocity>.4</max_linear_velocity><max_angular_velocity>.8</max_angular_velocity></plugin>
<plugin filename="gz-sim-joint-state-publisher-system" name="gz::sim::systems::JointStatePublisher"><topic>/joint_states</topic><update_rate>20</update_rate></plugin>
</model></world></sdf>
