<?xml version="1.0"?><robot name="maintenance_robot">
<link name="base_link"><visual><geometry><box size=".55 .4 .16"/></geometry><material name="orange"><color rgba=".8 .3 .15 1"/></material></visual></link>
<link name="lidar_link"/><joint name="lidar_mount" type="fixed"><parent link="base_link"/><child link="lidar_link"/><origin xyz="0 0 .16"/></joint>
<link name="camera_link"/><joint name="camera_mount" type="fixed"><parent link="base_link"/><child link="camera_link"/><origin xyz=".28 0 .12"/></joint>
<link name="camera_optical_frame"/><joint name="camera_optical" type="fixed"><parent link="camera_link"/><child link="camera_optical_frame"/><origin rpy="-1.570796 0 -1.570796"/></joint>
<link name="left_wheel"/><joint name="left_wheel_joint" type="continuous"><parent link="base_link"/><child link="left_wheel"/><origin xyz="0 .24 -.10"/><axis xyz="0 1 0"/></joint>
<link name="right_wheel"/><joint name="right_wheel_joint" type="continuous"><parent link="base_link"/><child link="right_wheel"/><origin xyz="0 -.24 -.10"/><axis xyz="0 1 0"/></joint>
</robot>